function updateConstellation(X, scenario, satCon)
    % Unpack parameters
    %P   = round(X(1)); % # of planes
    %S   = round(X(2)); % # of sats per plane
    %F   = round(X(3)); % phasing parameter
    %inc = X(4);        % inclination [deg]
    
P = 17; % # of planes
S = 11; % # of sats per plane
F = 3;  % Walker phasing parameter
inc = 70;       % inclination [deg]

   % sc = satelliteScenario;
    %sat = walkerDelta(sc, a, inc, T, P, F);

   % elements = zeros(7, length(sat));

%    for j = 1:length(sat)
 %      elem  = orbitalElements(sat(j));
  %     elements(1, j) = elem.SemiMajorAxis;
   %    elements(2, j) = elem.Eccentricity;
    %   elements(3, j) = elem.Inclination;
     %  elements(4, j) = elem.RightAscensionOfAscendingNode;
      % elements(5, j) = elem.ArgumentOfPeriapsis;
       %elements(6, j) = elem.TrueAnomaly;
       %elements(7, j) = elem.Period;
    %end
    
    a   = 7078e3;      % semi-major axis [m] — fixed
    ecc = 0;           % circular orbit
    aop = 0;           % argument of perigee [deg]
    T   = P * S;       % total satellites

    % Walker Delta pattern spacing formulas
    RAAN_spacing = 360 / P;           % deg between planes
    MA_spacing   = 360 / S;           % deg between sats in a plane
    phase_offset = F * (360 / T);     % deg phase shift between adjacent planes

    % Remove existing satellites from constellation
    while satCon.Children.Count > 0
        satCon.Children.Item(0).Unload();
    end

    % Build constellation plane by plane
    for p = 0:P-1
        RAAN = p * RAAN_spacing; % right ascension of ascending node

        for s = 0:S-1
            % Mean anomaly with inter-plane phasing
            MA = mod(s * MA_spacing + p * phase_offset, 360);

            % Create satellite name
            satName = sprintf('P%02d_S%02d', p+1, s+1);

            % Add satellite to constellation
            sat = satCon.Children.New('eSatellite', satName);

            % Set propagator to J2Perturbation or TwoBody
            sat.SetPropagatorType('ePropagatorJ2Perturbation');
            prop = sat.Propagator;
            prop.InitialState.Representation.AssignClassical(...
                'eCoordinateSystemJ2000', ...
                a, ecc, inc, RAAN, aop, MA);
            prop.Propagate();
        end
    end

    fprintf('Constellation updated: %d planes x %d sats (F=%d, inc=%.1f deg)\n', ...
        P, S, F, inc);

%end